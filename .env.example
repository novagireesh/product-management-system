# Copy this file to .env and adjust as needed.

# Port the app listens on
PORT=5050
# 0.0.0.0 = reachable from other devices on the network (needed for phones scanning QR codes)
HOST=0.0.0.0

# Where the database, images, catalogues and logs are stored.
# Recommended: a folder OUTSIDE OneDrive/Dropbox, e.g. C:\ProductData
DATA_DIR=data

# Days a sign-in stays valid
SESSION_DAYS=7

# Set both to true when the app runs behind an HTTPS reverse proxy
SECURE_COOKIES=false
TRUST_PROXY=false

# Upload limits (MB)
MAX_UPLOAD_MB=15
MAX_IMPORT_MB=50
