{
  "name": "product-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Product Management & Catalogue web application: Excel import, images, QR/barcodes, protected costing, buyer collections and PDF/PPT/Excel catalogues.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch-path=server server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "sample": "node scripts/make-sample.js && node scripts/make-costing-sample.js",
    "package": "node scripts/package.js",
    "backup": "node scripts/backup.js",
    "test": "node tests/e2e.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "bwip-js": "^4.11.4",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.49.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.2"
  }
}
